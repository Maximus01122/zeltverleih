DB_PASSWORD=IhrSicheresPasswortHier
# IONOS Postfach info@zeltverleiherfurt.de (SMTP smtp.ionos.de:587, STARTTLS)
MAIL_USERNAME=info@zeltverleiherfurt.de
MAIL_PASSWORD=IhrIonosPostfachPasswort
# Empfänger für Anfrage-Benachrichtigungen vom Kontaktformular
MAIL_NOTIFICATION_TO=info@zeltverleiherfurt.de
AUTH_USERNAME=mitarbeiter
# Produktion (empfohlen): BCrypt-Hash statt Klartext-Passwort
# Erzeugen: mvn -q exec:java -Dexec.mainClass=de.zeltverleih.util.BcryptHashGenerator -Dexec.args="IhrPasswort"
# Wichtig: In .env jedes $ im Hash verdoppeln ($$), sonst interpretiert Docker Compose es als Variable
AUTH_PASSWORD_HASH=
# Nur für lokale Entwicklung — in Produktion leer lassen und AUTH_PASSWORD_HASH setzen
AUTH_PASSWORD=IhrSicheresLoginPasswortHier
JWT_SECRET=Mindestens32ZeichenZufaelligerGeheimerSchluessel!!
